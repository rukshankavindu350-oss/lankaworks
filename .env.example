# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# INITIAL_SUPER_ADMIN_EMAIL: Email address allowed to claim/bootstrap initial Super Admin access.
INITIAL_SUPER_ADMIN_EMAIL=""

# RESEND_API_KEY: Optional transactional email provider API key for booking confirmations and notifications.
RESEND_API_KEY=""

# EMAIL_FROM: Sender email address when RESEND_API_KEY is configured.
EMAIL_FROM="LankaWorks <noreply@lankaworks.lk>"
